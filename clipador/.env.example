# Copie para .env e preencha o que quiser (tudo também pode ser configurado no painel).

# Chave da Anthropic: o Claude dá nota, título, legenda e hashtags de cada corte.
ANTHROPIC_API_KEY=

# Aviso no Discord quando um corte fica pronto / é postado.
DISCORD_WEBHOOK=

# Porta do painel.
PORT=8000

# Desliga o login (só use em rede local!).
# CLIPADOR_NO_AUTH=1
